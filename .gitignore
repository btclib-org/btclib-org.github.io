# What a local Jekyll build leaves behind. `bundle exec jekyll build`
# writes _site/ and the two caches beside it; GitHub Pages builds on its
# own side and none of this is ever served from here.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Gemfile.lock is committed -- it is the actual lock, `Gemfile` alone
# leaving every transitive gem as a range -- so only where `bundle
# install` is asked to vendor the gems themselves is there anything of
# this build left to ignore: vendor/ holds the gems, and .bundle/ the
# `bundle config set --local` that asked for them there
vendor/
.bundle/

# what macOS writes into a directory it has been looked at in
.DS_Store
